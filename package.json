{
  "name": "agentpay-receptionist",
  "version": "0.1.0",
  "description": "AgentPay Receptionist turns local businesses into AI-powered, x402-paid service endpoints on AWS",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node demo/local-server.mjs",
    "dev:demo": "node demo/local-server.mjs",
    "agent:pay": "node scripts/agent-pay-hold-slot.mjs",
    "sam:validate": "sam validate --region us-east-1",
    "sam:build": "sam build",
    "sam:deploy": "sam deploy --guided --region us-east-1 --capabilities CAPABILITY_NAMED_IAM",
    "sam:deploy:live": "node scripts/deploy-live.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "x402",
    "aws",
    "cloudfront",
    "lambda-edge",
    "waf",
    "payment",
    "agentic-commerce",
    "local-business"
  ],
  "license": "MIT-0",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.985.0",
    "@aws-sdk/client-cloudfront": "^3.985.0",
    "@aws-sdk/client-dynamodb": "^3.985.0",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/client-secrets-manager": "^3.985.0",
    "@aws-sdk/client-ssm": "^3.985.0",
    "@aws-sdk/client-wafv2": "^3.985.0",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "@x402/fetch": "^2.3.0",
    "jose": "^6.1.3",
    "viem": "^2.39.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^25.2.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
